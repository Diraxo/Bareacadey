# Copy to .env and fill in. Never commit .env. Every value below is a placeholder.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ACCESS_TOKEN_SECRET, REFRESH_TOKEN_SECRET, SESSION_SECRET and MEDIA_TOKEN_SECRET must all be different.

NODE_ENV=production
PORT=4000

# ---- Public URLs (single place to change when the domain changes) ----
# Public base URL of this API (also serves Socket.IO and media). Used in payment callbacks and OAuth redirects.
API_PUBLIC_URL=https://api.example.org
# Public URL of the website (used for CORS, e-mail links and redirects).
FRONTEND_URL=https://www.example.org
# Extra browser origins allowed by CORS, comma separated (optional).
CORS_ALLOWED_ORIGINS=
# Optional overrides when sockets or media live on a different host than the API.
SOCKET_PUBLIC_URL=
MEDIA_PUBLIC_URL=

# ---- Database (MySQL 8 / MariaDB 10.6+) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- Secrets ----
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SESSION_SECRET=
MEDIA_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
EMAIL_TOKEN_EXPIRES_IN=1h
# Lifetime of the token that lets <video>/<img> elements fetch protected media
MEDIA_TOKEN_TTL_SECONDS=21600

# ---- Cookies ----
# 'none' is needed when website and API are on different sites (requires https); 'lax'/'strict' otherwise.
COOKIE_SAMESITE=none

# ---- Mobile app compatibility ----
# Value of the x-react-native-app header compiled into released app builds. It is NOT a secret (it ships in the app)
# and is not authentication; it only filters casual traffic. Leave empty to refuse header-less (non-browser) clients.
MOBILE_APP_KEY=
MOBILE_UA_TOKEN=rnafm

# ---- Chapa payments ----
CHAPA_AUTH=
# CHAPA_URL=https://api.chapa.co/v1/transaction/initialize
# CHAPA_VERIFY_URL=https://api.chapa.co/v1/transaction/verify/

# ---- Google sign-in (leave empty to disable) ----
CLIENT_ID=
CLIENT_SECRET=

# ---- E-mail (SMTP) ----
EMAIL_HOST=
EMAIL_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FRIENDLY_NAME=Johar Academy

# ---- Optional ----
# TRUST_PROXY_HOPS=1
# APP_TIMEZONE=Africa/Addis_Ababa
# HLS_HOST=127.0.0.1
# HLS_PORT=5000
# UPLOAD_MAX_FILE_BYTES=1073741824
# UPLOAD_MAX_FILES_PER_UNIT=300
# UPLOAD_REQUEST_TIMEOUT_MS=3600000
# Upload protection (all optional; defaults shown). Checked after sign-in and before any body is written to disk.
# UPLOAD_MAX_FILES_PER_REQUEST=50
# UPLOAD_MAX_REQUEST_BYTES=1140850688        # default: UPLOAD_MAX_FILE_BYTES + 64 MB
# UPLOAD_INIT_RATE_LIMIT_PER_MIN=600         # upload requests one signed-in user may start per minute
# UPLOAD_PUBLIC_RATE_LIMIT_PER_HOUR=20       # anonymous sign-up photo uploads per address per hour
# UPLOAD_TEMP_MAX_AGE_HOURS=6                # abandoned temp files/directories older than this are removed
# Login sessions (one per browser/device). REFRESH_TOKEN_EXPIRES_IN above now only governs tokens issued BEFORE sessions.
# SESSION_IDLE_DAYS=30                       # sliding inactivity expiry
# SESSION_ABSOLUTE_DAYS=365                  # hard cap, never extended
# SESSION_ROTATION_GRACE_SECONDS=120         # a just-replaced browser token is still answered (lost response / second tab)
# SESSION_MAX_PER_USER=20                    # least recently used sessions beyond this are signed out
# LOGIN_RATE_LIMIT_MAX=10

# Every course is free (default). Set to "false" only to bring back the old paid behaviour.
# COURSES_ARE_FREE=true
