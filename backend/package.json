{
    "name": "johar-academy",
    "version": "1.0.0",
    "description": "Johar Academy API",
    "main": "server.js",
    "scripts": {
        "start": "node server",
        "hls": "node hls-server",
        "dev": "nodemon server",
        "dev2": "nodemon hls-server",
        "test": "jest --runInBand --forceExit",
        "db:init": "node scripts/db-init.js",
        "db:migrate": "node scripts/db-migrate.js",
        "admin:create": "node scripts/create-admin.js",
        "media:keyinfo": "node scripts/make-hls-keyinfo.js",
        "secrets:generate": "node scripts/generate-secrets.js",
        "secrets:revoke": "node scripts/revoke-secrets.js",
        "predeploy:check": "node scripts/predeploy-check.js",
        "release:make": "node scripts/make-release.js",
        "uploads:reconcile": "node scripts/reconcile-uploads.js"
    },
    "keywords": [],
    "author": "Ousman Seid",
    "license": "ISC",
    "dependencies": {
        "@ffmpeg-installer/ffmpeg": "^1.1.0",
        "axios": "^1.1.3",
        "bcrypt": "^5.1.0",
        "body-parser": "^1.20.1",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "date-fns": "^2.23.0",
        "dotenv": "^16.0.3",
        "ejs": "^3.1.8",
        "express": "^4.18.2",
        "express-fileupload": "^1.4.0",
        "express-rate-limit": "^7.4.0",
        "express-session": "^1.18.0",
        "express-validator": "^6.14.2",
        "ffmpeg-static": "^5.2.0",
        "ffprobe-static": "^3.1.0",
        "fluent-ffmpeg": "^2.1.2",
        "get-video-dimensions": "^1.0.0",
        "handlebars": "^4.7.7",
        "jsonwebtoken": "^9.0.2",
        "mg-api-js": "^2.1.1",
        "moment": "^2.29.4",
        "mysql2": "^3.11.0",
        "mz": "^2.7.0",
        "node-cron": "^3.0.3",
        "nodemailer": "^6.9.1",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "sequelize": "^6.24.0",
        "simple-hls": "^0.0.1",
        "socket.io": "^4.6.1",
        "string-similarity": "^4.0.4",
        "uuid": "^9.0.1"
    },
    "optionalDependencies": {
        "sharp": "^0.33.4"
    },
    "devDependencies": {
        "jest": "^29.3.1",
        "kill-port": "^2.0.1",
        "nodemon": "^2.0.20",
        "socket.io-client": "^4.6.1",
        "sqlite3": "^5.1.7",
        "supertest": "^7.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "globalTeardown": "<rootDir>/tests/globalTeardown.js",
        "setupFiles": [
            "<rootDir>/tests/setup.js"
        ],
        "testMatch": [
            "<rootDir>/tests/**/*.test.js"
        ],
        "testTimeout": 30000
    },
    "engines": {
        "node": ">=18"
    }
}
